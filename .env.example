# Copy to .env (or export these in your shell) before running the app.
# AUTH_SECRET_KEY is required — the app refuses to start without it.
# ADMIN_USERNAME / ADMIN_PASSWORD are optional; if unset, no admin account
# is seeded and the app logs a warning at startup.

AUTH_SECRET_KEY=change-me-to-a-long-random-value
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too
